{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PLAN",
  "scopeName": "source.plan",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.plan",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-dash.plan",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.plan",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.plan",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.plan",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.plan",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.plan",
          "match": "\\b-?\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.plan",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.plan",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.plan",
          "match": "\\bnothing\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.plan",
          "match": "\\b(Create a variable called|Create a function called|Create an empty list called|Create an empty dictionary called)\\b"
        },
        {
          "name": "keyword.operator.assignment.plan",
          "match": "\\b(Set|to|with value)\\b"
        },
        {
          "name": "keyword.control.conditional.plan",
          "match": "\\b(When|Otherwise when|Otherwise|then)\\b"
        },
        {
          "name": "keyword.control.loop.plan",
          "match": "\\b(For every|from|to|in steps of|Repeat|times|While)\\b"
        },
        {
          "name": "keyword.control.flow.plan",
          "match": "\\b(Stop loop|Stop program|Skip loop|Return)\\b"
        },
        {
          "name": "keyword.control.trycatch.plan",
          "match": "\\b(Try this|If it fails|Always do this)\\b"
        },
        {
          "name": "keyword.other.module.plan",
          "match": "\\b(Use shared|Use|from)\\b"
        },
        {
          "name": "keyword.other.python.plan",
          "match": "^\\s*(Python:).*$"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.plan",
          "match": "\\b(whole number|number|text|flag|list|dictionary)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.plan",
          "match": "\\b(is equal to|is not equal to|is at least|is at most|is greater than|is less than|is between|is empty|is nothing|is not nothing|is not)\\b"
        },
        {
          "name": "keyword.operator.logical.plan",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.plan",
          "match": "\\b(plus|minus|times|divided by|to the power of|modulo)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.io.plan",
          "match": "\\b(Show|Ask for)\\b"
        },
        {
          "name": "support.function.builtin.plan",
          "match": "\\b(square root of|absolute value of|round|length of|first item of|last item of|item|of|keys of|values of|add|append|to|remove)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function-call.plan",
          "match": "\\b(Call)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.call.plan" },
            "2": { "name": "entity.name.function.plan" }
          }
        },
        {
          "name": "keyword.other.function-def.plan",
          "match": "\\b(that accepts|and gives back)\\b"
        }
      ]
    }
  }
}
