{
  "name": "plan-and-ndot",
  "displayName": "PLAN & N-DOT Language Support",
  "description": "Language support, syntax highlighting, diagnostics, compilation, and execution for PLAN (Plain Language) and N-DOT (Neural-DOT).",
  "version": "0.1.0",
  "publisher": "airmeorganization",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "plan",
    "ndot",
    "controlled-english",
    "neural",
    "compiler"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:plan",
    "onLanguage:ndot",
    "onLanguage:ndasm",
    "onCommand:plan.run",
    "onCommand:plan.build",
    "onCommand:plan.check",
    "onCommand:plan.toPython",
    "onCommand:ndot.run",
    "onCommand:ndot.build",
    "onCommand:ndot.check",
    "onCommand:ndot.disassemble",
    "onCommand:ndot.assemble"
  ],
  "contributes": {
    "languages": [
      {
        "id": "plan",
        "aliases": ["PLAN", "plan"],
        "extensions": [".plan"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ndot",
        "aliases": ["N-DOT", "ndot"],
        "extensions": [".ndot"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ndasm",
        "aliases": ["N-DOT Assembly", "ndasm"],
        "extensions": [".ndasm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plan",
        "scopeName": "source.plan",
        "path": "./syntaxes/plan.tmLanguage.json"
      },
      {
        "language": "ndot",
        "scopeName": "source.ndot",
        "path": "./syntaxes/ndot.tmLanguage.json"
      },
      {
        "language": "ndasm",
        "scopeName": "source.ndot",
        "path": "./syntaxes/ndot.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "plan.run",
        "title": "PLAN: Run Program",
        "icon": "$(play)"
      },
      {
        "command": "plan.build",
        "title": "PLAN: Build to Python",
        "icon": "$(gear)"
      },
      {
        "command": "plan.check",
        "title": "PLAN: Check Semantics",
        "icon": "$(check)"
      },
      {
        "command": "plan.toPython",
        "title": "PLAN: Preview Generated Python",
        "icon": "$(file-code)"
      },
      {
        "command": "ndot.run",
        "title": "N-DOT: Run Program",
        "icon": "$(play)"
      },
      {
        "command": "ndot.build",
        "title": "N-DOT: Build to Python",
        "icon": "$(gear)"
      },
      {
        "command": "ndot.check",
        "title": "N-DOT: Check Program",
        "icon": "$(check)"
      },
      {
        "command": "ndot.disassemble",
        "title": "N-DOT: Disassemble to .ndasm",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "ndot.assemble",
        "title": "N-DOT: Assemble to .ndot",
        "icon": "$(symbol-misc)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "plan.run",
          "group": "navigation@1",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "ndot.run",
          "group": "navigation@1",
          "when": "editorLangId == ndot || editorLangId == ndasm || resourceExtname == .ndot || resourceExtname == .ndasm"
        }
      ],
      "editor/title": [
        {
          "command": "plan.run",
          "group": "navigation@1",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "plan.toPython",
          "group": "navigation@2",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "ndot.run",
          "group": "navigation@1",
          "when": "editorLangId == ndot || editorLangId == ndasm || resourceExtname == .ndot || resourceExtname == .ndasm"
        },
        {
          "command": "ndot.disassemble",
          "group": "navigation@2",
          "when": "editorLangId == ndot || resourceExtname == .ndot"
        },
        {
          "command": "ndot.assemble",
          "group": "navigation@2",
          "when": "editorLangId == ndasm || resourceExtname == .ndasm"
        }
      ],
      "editor/context": [
        {
          "command": "plan.run",
          "group": "1_plan@1",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "plan.build",
          "group": "1_plan@2",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "plan.toPython",
          "group": "1_plan@3",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "plan.check",
          "group": "1_plan@4",
          "when": "editorLangId == plan || resourceExtname == .plan"
        },
        {
          "command": "ndot.run",
          "group": "1_ndot@1",
          "when": "editorLangId == ndot || editorLangId == ndasm || resourceExtname == .ndot || resourceExtname == .ndasm"
        },
        {
          "command": "ndot.build",
          "group": "1_ndot@2",
          "when": "editorLangId == ndot || resourceExtname == .ndot"
        },
        {
          "command": "ndot.check",
          "group": "1_ndot@3",
          "when": "editorLangId == ndot || resourceExtname == .ndot"
        },
        {
          "command": "ndot.disassemble",
          "group": "1_ndot@4",
          "when": "editorLangId == ndot || resourceExtname == .ndot"
        },
        {
          "command": "ndot.assemble",
          "group": "1_ndot@5",
          "when": "editorLangId == ndasm || resourceExtname == .ndasm"
        }
      ],
      "explorer/context": [
        {
          "command": "plan.run",
          "group": "1_plan@1",
          "when": "resourceExtname == .plan"
        },
        {
          "command": "plan.build",
          "group": "1_plan@2",
          "when": "resourceExtname == .plan"
        },
        {
          "command": "plan.toPython",
          "group": "1_plan@3",
          "when": "resourceExtname == .plan"
        },
        {
          "command": "ndot.run",
          "group": "1_ndot@1",
          "when": "resourceExtname == .ndot || resourceExtname == .ndasm"
        },
        {
          "command": "ndot.build",
          "group": "1_ndot@2",
          "when": "resourceExtname == .ndot"
        },
        {
          "command": "ndot.disassemble",
          "group": "1_ndot@3",
          "when": "resourceExtname == .ndot"
        },
        {
          "command": "ndot.assemble",
          "group": "1_ndot@4",
          "when": "resourceExtname == .ndasm"
        }
      ]
    },
    "configuration": {
      "title": "PLAN & N-DOT",
      "properties": {
        "plan.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python 3 executable for running the PLAN compiler."
        },
        "plan.allowPython": {
          "type": "boolean",
          "default": false,
          "description": "Allow raw 'Python:' lines in PLAN programs (--allow-python)."
        },
        "plan.allowAllModules": {
          "type": "boolean",
          "default": false,
          "description": "Lift restriction on importing system modules in PLAN (--allow-all-modules)."
        },
        "ndot.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python 3 executable for running N-DOT toolchain."
        },
        "ndot.allowFiles": {
          "type": "boolean",
          "default": false,
          "description": "Allow file operations (803, 805, 406, 102, 106) in N-DOT programs (--allow-files)."
        },
        "ndot.allowNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Allow network fetch operations (804) in N-DOT programs (--allow-network)."
        },
        "planAndNdot.diagnosticsOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run check diagnostics automatically on save."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"process.exit(0)\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.3"
  }
}
